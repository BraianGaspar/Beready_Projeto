# APP CONFIGURATION
APP_NAME="Beready"
APP_ENV="development"
APP_BASE_URL="http://localhost:5173/"
DEBUG=true
APP_ENCODING="UTF-8"
APP_DEFAULT_LOCALE="pt_BR"
APP_DEFAULT_TIMEZONE="America/Sao_Paulo"

# SECURITY
SECURITY_SALT="coloque_uma_string_forte_aqui"
JWT_SECRET="coloque_um_jwt_super_forte_aqui"

# DATABASE - Supabase / PostgreSQL
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DB?sslcert=require"

# DATABASE - testes (PHPUnit). Use um Postgres descartável: o schema é recriado e os dados apagados a cada execução
TEST_DATABASE_URL="postgres://postgres:test@127.0.0.1:55432/beready_test"

# CORS - Origens permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000"

# EMAIL - Gmail SMTP (recomendado para testes)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USERNAME="seu-email@gmail.com"
EMAIL_PASSWORD="SUA_SENHA_DE_APP_AQUI"
EMAIL_TLS="true"
EMAIL_FROM="seu-email@gmail.com"
EMAIL_FROM_NAME="BeReady"

# SENTRY
SENTRY_DSN=""
APP_ENV="development"

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_API_URL="https://api.cloudinary.com/v1_1"
CLOUDINARY_UPLOAD_FOLDER="beready/profile"

# GOOGLE OAuth
GOOGLE_CLIENT_ID="seu_client_id_google.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu_client_secret_google"
GOOGLE_REDIRECT_URI="http://localhost:8765/social-auth/callback/google"
GOOGLE_AUTH_URL="https://accounts.google.com/o/oauth2/v2/auth"
GOOGLE_TOKEN_URL="https://oauth2.googleapis.com/token"
GOOGLE_USERINFO_URL="https://www.googleapis.com/oauth2/v3/userinfo"

# FACEBOOK OAuth
FACEBOOK_CLIENT_ID="seu_facebook_app_id"
FACEBOOK_CLIENT_SECRET="seu_facebook_app_secret"
FACEBOOK_REDIRECT_URI="http://localhost:8765/social-auth/callback/facebook"
FACEBOOK_AUTH_URL="https://www.facebook.com/v18.0/dialog/oauth"
FACEBOOK_TOKEN_URL="https://graph.facebook.com/v18.0/oauth/access_token"
FACEBOOK_USERINFO_URL="https://graph.facebook.com/v18.0/me"

# LINKEDIN OAuth
LINKEDIN_CLIENT_ID="seu_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="seu_linkedin_client_secret"
LINKEDIN_REDIRECT_URI="http://localhost:8765/social-auth/callback/linkedin"
LINKEDIN_AUTH_URL="https://www.linkedin.com/oauth/v2/authorization"
LINKEDIN_TOKEN_URL="https://www.linkedin.com/oauth/v2/accessToken"
LINKEDIN_USERINFO_URL="https://api.linkedin.com/v2/userinfo"

# RECAPTCHA v3
RECAPTCHA_SECRET_KEY="sua_chave_secreta_do_recaptcha"
RECAPTCHA_VERIFY_URL="https://www.google.com/recaptcha/api/siteverify"

# STRIPE - PAGAMENTOS
STRIPE_SECRET_KEY="sua_chave_secreta_stripe_aqui"
STRIPE_WEBHOOK_SECRET="seu_webhook_stripe_aqui"

# AUTH - cookie httpOnly do refresh token (Path=/auth)
# SameSite: Lax (mesmo site) ou None (frontend em outro dominio; exige Secure=true)
REFRESH_COOKIE_SAMESITE="Lax"
REFRESH_COOKIE_SECURE=false
