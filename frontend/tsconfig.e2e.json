// TSConfig dos testes E2E (Playwright): Node + DOM (callbacks de page.evaluate rodam no navegador).
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["e2e/**/*.ts"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    // Tipos do app (src/core/types) usam o alias "@/"
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  }
}
